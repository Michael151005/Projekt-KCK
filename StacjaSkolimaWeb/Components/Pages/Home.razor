@page "/"
@rendermode InteractiveServer

<PageTitle>Stacja Skolima - System Obsługi</PageTitle>

<!-- Górny pasek nawigacji -->
<header class="navbar">
    <div class="brand">
        <span>⛽</span>
        <span class="brand-stacja">STACJA</span>
        <span class="brand-skolima">SKOLIMA</span>
    </div>

    <!-- Przełącznik rół -->
    <nav class="role-switcher">
        <button class="role-btn @(aktywnaRola == "Klient" ? "active" : "")" @onclick='() => WybierzRole("Klient")'>
            Klient
        </button>
        <button class="role-btn @(aktywnaRola == "Pracownik" ? "active" : "")" @onclick='() => WybierzRole("Pracownik")'>
            Pracownik
        </button>
        <button class="role-btn @(aktywnaRola == "Kierownik" ? "active" : "")" @onclick='() => WybierzRole("Kierownik")'>
            Kierownik
        </button>
    </nav>
</header>

<!-- Główny obszar roboczy -->
<main class="main-container">
    @if (aktywnaRola == "Klient")
    {
        <PanelKlienta OnPowiadomienie="ObsluzPowiadomienieKomponentu" />
    }
    else if (aktywnaRola == "Pracownik")
    {
        <PanelPracownika OnPowiadomienie="ObsluzPowiadomienieKomponentu" />
    }
    else if (aktywnaRola == "Kierownik")
    {
        <div class="card animate-fade">
            <h2 style="color: var(--skolima-magenta); margin-bottom: 8px;">Panel Kierownika</h2>
            <p style="color: var(--text-muted);">Zalogowano pomyślnie! Tutaj podepniemy zmianę cen i raporty sprzedaży.</p>
        </div>
    }
</main>

<!-- Okno modalne logowania -->
@if (pokazModalLogowania)
{
    <div class="modal-backdrop" @onclick="AnulujLogowanie">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3 style="margin-bottom: 6px; color: var(--skolima-cyan);">
                Autoryzacja: @docelowaRola
            </h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 18px;">
                Podaj hasło dostepu
            </p>

            <input type="password" class="input-skolima" placeholder="Wpisz hasło..." @bind="wpisaneHaslo" @bind:event="oninput" @onkeydown="ObsluzKlawiszWLogowaniu" autofocus/>

            @if (!string.IsNullOrEmpty(bladLogowania))
            {
                <p style="color: var(--danger); font-size: 0.85rem; margin-top: 8px;">
                    @bladLogowania
                </p>
            }

            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 22px;">
                <button class="btn-ghost" @onclick="AnulujLogowanie">Anuluj (Esc)</button>
                <button class="btn-magenta" @onclick="ZatwierdzLogowanie">Zaloguj (Enter)</button>
            </div>
        </div>
    </div>
}

<!-- Powiadomienie w rogu ekranu -->
@if (!string.IsNullOrEmpty(komunikatToast))
{
    <div class="toast-container">
        <div class="toast @(czyToastSukces ? "success" : "error")">
            <span>@(czyToastSukces ? "✔" : "✖")</span>
            <span>@komunikatToast</span>
        </div>
    </div>
}

@code {
    // Stan aplikacji
    private string aktywnaRola = "Klient";
    private string docelowaRola = "";
    private bool pokazModalLogowania = false;
    private string wpisaneHaslo = "";
    private string bladLogowania = "";

    // Stan powiadomień
    private string komunikatToast = "";
    private bool czyToastSukces = true;

    protected override void OnInitialized()
    {
        AutoryzacjaService.ZainicjujHasla();
    }

    private void WybierzRole(string rola)
    {
        if (rola == aktywnaRola) return;

        if (rola == "Klient")
        {
            aktywnaRola = "Klient";
            PokazPowiadomienie("Przełączono na tryb Klienta", true);
        }
        else
        {
            docelowaRola = rola;
            wpisaneHaslo = "";
            bladLogowania = "";
            pokazModalLogowania = true;
        }
    }

    private void ZatwierdzLogowanie()
    {
        if (AutoryzacjaService.WeryfikujHaslo(docelowaRola, wpisaneHaslo))
        {
            aktywnaRola = docelowaRola;
            pokazModalLogowania = false;
            wpisaneHaslo = "";
            PokazPowiadomienie($"Zalogowano jako {aktywnaRola}", true);
        }
        else
        {
            bladLogowania = "Błędne hasło! Dostęp odmówiony.";
        }
    }

    private void AnulujLogowanie()
    {
        pokazModalLogowania = false;
        wpisaneHaslo = "";
        bladLogowania = "";
    }

    // Obsługa klawiatury
    private void ObsluzKlawiszWLogowaniu(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ZatwierdzLogowanie();
        }
        else if (e.Key == "Escape")
        {
            AnulujLogowanie();
        }
    }

    // Wyświetla powiadomienie i automatycznie je chowa po 3 sekundach
    private async void PokazPowiadomienie(string tresc, bool sukces)
    {
        komunikatToast = tresc;
        czyToastSukces = sukces;
        StateHasChanged();

        await Task.Delay(3000);
        if (komunikatToast == tresc)
        {
            komunikatToast = "";
            StateHasChanged();
        }
    }

    private void ObsluzPowiadomienieKomponentu((string Tresc, bool Sukces) dane)
    {
        PokazPowiadomienie(dane.Tresc, dane.Sukces);
    }
}